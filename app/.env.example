# URL de Home Assistant. ATTENTION AU PORT, il n'est pas le même partout :
#   Home Assistant OS, sur le Pi   http://homeassistant.local     (port 80)
#   la pile Docker, sur le poste   http://localhost:8123
# Hors de la maison, l'URL Nabu Casa ou Tailscale prend la place.
VITE_HA_URL=http://homeassistant.local
# Profil HA > Sécurité > Jetons d'accès de longue durée
VITE_HA_TOKEN=coller_le_token_ici

# Le Pi seulement (docker-compose.pi.yml) : la clé Zigbee, par son chemin
# stable — jamais /dev/ttyUSB0, dont le numéro change à chaque redémarrage.
#   ls -l /dev/serial/by-id/
# ZIGBEE_DEVICE=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_xxxx-if00-port0
